# Local GitHub auth is normally read from gh auth token.
# SNS credentials are used only by GitHub Actions Secrets.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=
INSTAGRAM_TOKEN_EXPIRES_AT=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_VERSION=
THREADS_TOKEN_EXPIRES_AT=

# Repository Variables / non-secret local configuration
STATE_BRANCH=publisher-state
MAX_LATENESS_MINUTES=1440
MAX_POSTS_PER_RUN=10
ASSET_MODE=pages
ASSET_BASE_URL=
GITHUB_PAGES_URL=
